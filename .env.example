# ==== Wallet ====
# Private key of the trading wallet, base58-encoded (Phantom "Export Private Key" format).
# NEVER commit this file with a real key. Use a DEDICATED wallet, not your main wallet.
# Fund it only with the amount you are prepared to lose entirely.
PRIVATE_KEY=

# ==== RPC ====
# Public RPC endpoints are too slow/rate-limited for real sniping. Use a paid low-latency
# provider (Helius, QuickNode, Triton) in production. Free endpoint is fine for testing wiring.
RPC_HTTP_URL=https://api.mainnet-beta.solana.com
RPC_WSS_URL=wss://api.mainnet-beta.solana.com

# ==== Trading parameters ====
# All of these are also editable live from the web dashboard (state.ts holds the runtime
# value; these are just the startup defaults / fallback if the dashboard was never touched).
# Amount of SOL to spend per snipe
BUY_AMOUNT_SOL=0.01
# Max acceptable slippage in percent, separately for buy and sell (sell after a big pump
# often needs more headroom than the initial snipe buy). SLIPPAGE_PERCENT is a legacy
# fallback used for both if the specific ones aren't set.
SLIPPAGE_BUY_PERCENT=10
SLIPPAGE_SELL_PERCENT=15
# SLIPPAGE_PERCENT=10
# Target total priority fee per transaction, in SOL (not micro-lamports/CU — converted
# internally based on the tx's compute unit limit, see src/trade/priorityFee.ts).
PRIORITY_FEE_SOL=0.00006
# Master switch: bot only executes real buys/sells when true. Keep false until you have
# tested the full pipeline (detection -> filters -> dry-run logs) and understand the risk.
LIVE_TRADING=false

# ==== Auto-sell (take-profit / stop-loss) ====
# Percent move (vs. actual entry price paid) that triggers an automatic sell of the whole
# position. Checked every few seconds by the position monitor for as long as the bot process
# is running. Set to 0 to disable that side.
TAKE_PROFIT_PERCENT=50
STOP_LOSS_PERCENT=20

# ==== Safety filters (recommended, can be disabled individually) ====
# Skip tokens whose mint/freeze authority has not been revoked (common rug vector)
REQUIRE_MINT_AUTHORITY_REVOKED=true
REQUIRE_FREEZE_AUTHORITY_REVOKED=true
# Minimum initial virtual SOL reserves on the bonding curve to consider a token (filters dust/instant-drain launches)
MIN_INITIAL_SOL_RESERVES=1
# Skip the snipe if the creator has already routed more than this much SOL into the bonding
# curve (their own dev-buy) by the time we check, right before buying. 0 disables this check.
# Note: this can only abort OUR buy before we send it — it cannot cancel a transaction that
# was already broadcast.
MAX_CREATOR_BUY_SOL=0

# ==== Dev wallet whitelist ====
# Comma-separated base58 wallet addresses. Only used in "watchlist" sniping mode (see
# SNIPE_MODE below) — the bot ONLY snipes tokens deployed by these creators (useful if
# you've identified specific devs whose launches tend to graduate). Empty list = snipe
# nobody in watchlist mode, not "snipe everyone" — see SNIPE_MODE for that. Editable from
# the dashboard; changes there persist to data/watched-dev-wallets.json and take precedence
# over this on restart.
WATCHED_DEV_WALLETS=

# ==== Sniping mode ====
# "watchlist" (default, safe): only buy tokens from WATCHED_DEV_WALLETS above.
# "all": ignore the whitelist and try to buy every new pump.fun token that passes the other
# safety filters (min reserves, authorities revoked, max creator buy). Much higher buy
# volume/risk — the dashboard requires MAX_BUYS_PER_SESSION > 0 before it'll let you switch
# into this mode, since nothing else caps total spend.
SNIPE_MODE=watchlist
# Caps how many buys the engine executes in one Start->Stop run, in either mode. 0 =
# unlimited. Once the cap is hit the engine stops itself automatically.
MAX_BUYS_PER_SESSION=0

# ==== Web dashboard ====
WEB_PORT=3000
# Simple shared-secret auth for the local dashboard (it's on your machine, but don't skip this
# if you ever expose the port beyond localhost)
WEB_DASHBOARD_TOKEN=change-me

# ==== Telegram ====
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to control the bot. Get yours from @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=
